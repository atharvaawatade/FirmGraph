<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>FirmGraph — {{ manifest.scan_id }}</title>
<style>
  :root { --ink:#14201a; --muted:#5a6b62; --line:#e2e8e4; --green:#0a7a4a; --amber:#b06000; --red:#b00020; --bg:#fafbfa; }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; margin: 0 auto; max-width: 62rem; color: var(--ink); padding: 2rem 1.5rem; line-height: 1.5; }
  h1 { font-size: 1.7rem; margin: 0 0 .2rem; }
  .sub { color: var(--muted); font-size: .9rem; margin: 0 0 1.2rem; }
  h2 { font-size: 1.15rem; margin: 2.2rem 0 .5rem; padding-bottom: .3rem; border-bottom: 2px solid var(--green); }
  table { border-collapse: collapse; width: 100%; margin: .8rem 0; font-size: .88rem; }
  th, td { border: 1px solid var(--line); padding: .45rem .6rem; text-align: left; vertical-align: top; }
  th { background: #f1f5f2; font-weight: 600; }
  tr:nth-child(even) td { background: #fcfdfc; }
  code { background: #eef2ef; padding: .1rem .35rem; border-radius: 4px; font-size: .85em; }
  .banner { padding: .8rem 1rem; border-radius: 8px; margin: 1rem 0; }
  .warn { background: #fff6e0; border: 1px solid #e6c877; }
  .danger { background: #fdeaea; border: 1px solid #e0a3a3; }
  .sev-critical { color: var(--red); font-weight: 700; }
  .sev-high { color: var(--amber); font-weight: 600; }
  .sev-medium { color: #8a6d00; }
  .sev-low { color: #4a6a4a; }
  .hero { display: flex; align-items: stretch; gap: .5rem; margin: 1.4rem 0 .6rem; flex-wrap: wrap; }
  .stat { flex: 1 1 8rem; background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 1rem; text-align: center; }
  .stat .num { font-size: 2.1rem; font-weight: 800; line-height: 1; }
  .stat .lbl { font-size: .74rem; color: var(--muted); margin-top: .4rem; text-transform: uppercase; letter-spacing: .04em; }
  .stat.killed { background: #fff6e0; border-color: #e6c877; }
  .stat.killed .num { color: var(--amber); }
  .stat.signal { background: #eaf7f0; border-color: #9ad3b5; }
  .stat.signal .num { color: var(--green); }
  .arrow { align-self: center; color: var(--muted); font-size: 1.4rem; font-weight: 700; }
  .noise-line { background: var(--bg); border-left: 4px solid var(--green); padding: .7rem 1rem; border-radius: 0 8px 8px 0; margin: .4rem 0 1rem; font-size: .92rem; }
  details.proof { margin: .2rem 0 1rem; font-size: .84rem; }
  details.proof summary { cursor: pointer; color: var(--muted); }
  details.proof code { display: inline-block; margin: .15rem 0; }
  footer { margin-top: 2.5rem; font-size: .8rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: .9rem; }
  @media (max-width: 640px) { .arrow { display: none; } }
</style>
</head>
<body>
<h1>FirmGraph Scan Report</h1>
<p class="sub"><code>{{ manifest.scan_id }}</code> · {{ manifest.created_at }} · FirmGraph {{ manifest.firmgraph_version }}</p>

{% if stub_stages %}
<div class="banner warn"><strong>Walking-skeleton build:</strong> stub stages emitting placeholder data: {{ stub_stages | join(", ") }}. This report demonstrates the pipeline, not a security verdict.</div>
{% endif %}
{% if failed_stages %}
<div class="banner danger"><strong>Stage failures (recorded, not hidden):</strong> {{ failed_stages | join(", ") }}.</div>
{% endif %}

{% if noise.raw %}
<section class="hero">
  <div class="stat"><div class="num">{{ noise.raw }}</div><div class="lbl">findings detected</div></div>
  {% if noise.suppressed %}<div class="arrow">&rarr;</div>
  <div class="stat killed"><div class="num">{{ noise.suppressed }}</div><div class="lbl">ruled out with proof</div></div>{% endif %}
  <div class="arrow">&rarr;</div>
  <div class="stat signal"><div class="num">{{ noise.signal }}</div><div class="lbl">that actually matter</div></div>
</section>
{% if noise.suppressed %}
<p class="noise-line"><strong>{{ noise.reduction_pct }}% of the noise removed.</strong>
  {{ noise.by_config }} kernel CVEs ruled out by config analysis — the subsystem isn't compiled into this firmware{% if noise.by_rule %}; {{ noise.by_rule }} by review rules{% endif %}. Every one is kept below with its reason, never deleted.</p>
{% if noise.config_samples %}
<details class="proof"><summary>Sample proof — why these could be ruled out</summary>
{% for s in noise.config_samples %}<code>{{ s }}</code><br>{% endfor %}
</details>
{% endif %}
{% endif %}
{% endif %}

<h2>Scan identity (reproducibility receipt)</h2>
<table>
  <tr><th>Scan ID</th><td><code>{{ manifest.scan_id }}</code></td></tr>
  <tr><th>Image</th><td><code>{{ manifest.image_path }}</code></td></tr>
  <tr><th>SHA-256</th><td><code>{{ manifest.image_sha256 }}</code></td></tr>
  <tr><th>Size / format</th><td>{{ manifest.image_size }} bytes · {{ manifest.image_format }}</td></tr>
  <tr><th>FirmGraph</th><td>{{ manifest.firmgraph_version }}</td></tr>
  <tr><th>Created</th><td>{{ manifest.created_at }}</td></tr>
  <tr><th>Tools</th><td>{% for t in manifest.tool_versions %}{{ t.name }} {{ t.version }}{% if not loop.last %} · {% endif %}{% endfor %}</td></tr>
</table>

{% if extraction %}
<h2>Extraction — honesty first</h2>
<table>
  <tr><th>Method</th><td>{{ extraction.method }}</td></tr>
  <tr><th>Confidence</th><td><strong>{{ "%.0f" | format(extraction.confidence * 100) }}%</strong></td></tr>
  <tr><th>Files extracted</th><td>{{ extraction.files_extracted }}</td></tr>
</table>
{% if extraction.confidence < 0.5 %}
<div class="banner danger"><strong>Low extraction confidence.</strong> Findings below are NOT a security verdict — a clean result on unextracted firmware is a false negative, not a safe device.</div>
{% endif %}
{% endif %}

{% if summary %}
<h2>Summary</h2>
<table>
  <tr><th>Components</th><td>{{ summary.components }}</td></tr>
  <tr><th>Findings</th><td>{{ summary.findings }} — <span class="sev-critical">{{ summary.critical }} critical</span> · <span class="sev-high">{{ summary.high }} high</span> · {{ summary.medium }} medium · {{ summary.low }} low</td></tr>
  <tr><th>Act now (P1–P3)</th><td><strong>{{ summary.act_now }}</strong> &nbsp;·&nbsp; Backlog (P4–P5): {{ summary.backlog }}</td></tr>
  <tr><th>Known-exploited (KEV)</th><td><strong>{{ summary.kev }}</strong> &nbsp;·&nbsp; No fix available (EOL): {{ summary.no_fix }}</td></tr>
</table>
{% endif %}

{% if top_findings %}
<h2>Top priorities — act on these first ({{ top_findings | length }})</h2>
<table>
  <tr><th>#</th><th>ID</th><th>Priority</th><th>Severity</th><th>Component</th><th>Why it ranks here</th></tr>
  {% for f in top_findings %}
  <tr>
    <td>{{ loop.index }}</td>
    <td><code>{{ f.finding_id }}</code></td>
    <td><strong>P{{ f.priority }}</strong></td>
    <td class="sev-{{ f.severity }}">{{ f.severity }}</td>
    <td>{{ f.component or "—" }}</td>
    <td>{{ f.priority_reason }}</td>
  </tr>
  {% if explanations.get(f.finding_id) %}
  <tr><td></td><td colspan="5" style="font-size:.85rem;color:#444;background:#fafcfa;"><em>{{ advisory_label }}:</em> {{ explanations[f.finding_id] }}</td></tr>
  {% endif %}
  {% endfor %}
</table>
{% endif %}

{% if groups %}
<h2>Findings by component</h2>
<table>
  <tr><th>Component</th><th>Findings</th><th>Critical</th><th>High</th><th>KEV</th><th>No fix</th></tr>
  {% for g in groups %}
  <tr>
    <td>{{ g.component }}{% if g.flood %} <span title="version-match flood — see Honest Limits" style="color:#b06000;">⚠</span>{% endif %}</td>
    <td>{{ g.total }}</td>
    <td class="sev-critical">{{ g.critical or "" }}</td>
    <td class="sev-high">{{ g.high or "" }}</td>
    <td>{{ g.kev or "—" }}</td>
    <td>{{ g.no_fix or "—" }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<h2>All findings (showing {{ findings | length }} of {{ findings_total }}, by priority)</h2>
{% if findings %}
<table>
  <tr><th>ID</th><th>Priority</th><th>Severity</th><th>Component</th><th>Fix</th><th>KEV</th><th>EPSS</th><th>Reachable</th></tr>
  {% for f in findings %}
  <tr>
    <td><code>{{ f.finding_id }}</code></td>
    <td title="{{ f.priority_reason }}">P{{ f.priority }}</td>
    <td class="sev-{{ f.severity }}">{{ f.severity }}</td>
    <td>{{ f.component or "—" }}</td>
    <td>{% if f.fix %}{{ f.fix }}{% else %}<strong>no fix available (EOL evidence)</strong>{% endif %}</td>
    <td>{{ "yes" if f.kev else "—" }}</td>
    <td>{{ f.epss if f.epss is not none else "—" }}</td>
    <td>{% if f.reachable is true %}yes{% elif f.reachable is false %}no{% else %}n/a{% endif %}</td>
  </tr>
  {% endfor %}
</table>
{% if findings_total > findings_cap %}
<p style="color:#555;">…and {{ findings_total - findings_cap }} more — the complete, unabridged list is in <code>evidence-pack/findings.json</code> (the audit record).</p>
{% endif %}
{% else %}
<p>No findings recorded by the current pipeline stages.</p>
{% endif %}

{% if binscan_findings %}
<h2>Binary-signature findings — cve-bin-tool ({{ binscan_findings | length }})</h2>
<div class="banner warn">A second, independent engine that fingerprints components inside stripped binaries Syft can't name. Shown <strong>separately and never merged</strong> with the SBOM path — two engines, no false reconciliation.</div>
<table>
  <tr><th>ID</th><th>Priority</th><th>Severity</th><th>Component</th><th>Fix</th></tr>
  {% for f in binscan_findings %}
  <tr>
    <td><code>{{ f.finding_id }}</code></td>
    <td title="{{ f.priority_reason }}">P{{ f.priority }}</td>
    <td class="sev-{{ f.severity }}">{{ f.severity }}</td>
    <td>{{ f.component or "—" }}</td>
    <td>{% if f.fix %}{{ f.fix }}{% else %}<strong>no fix available (EOL evidence)</strong>{% endif %}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{% if vex.total %}
<h2>Exploitability statement (VEX) — drafted, you sign</h2>
<p>Of <strong>{{ vex.total }}</strong> CVEs:
  <strong>{{ vex.affected }}</strong> affected ·
  <strong>{{ vex.not_affected_count }}</strong> not affected ·
  <strong>{{ vex.under_investigation }}</strong> under investigation.
  Full OpenVEX + CycloneDX-VEX in <code>evidence-pack/</code> — the machine-readable
  answer to "which CVEs matter, and why the rest don't".</p>
{% if vex.not_affected %}
<table>
  <tr><th>CVE</th><th>Component</th><th>Assessed not_affected because…</th></tr>
  {% for na in vex.not_affected %}
  <tr><td><code>{{ na.id }}</code></td><td>{{ na.component }}</td><td>{{ na.reason }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}

{% if cra_rows %}
<h2>CRA Annex I mapping (best-effort — not legal advice)</h2>
<div class="banner warn">{{ cra_disclaimer }}</div>
<table>
  <tr><th>Requirement</th><th>Title</th><th>Findings</th><th>Examples</th></tr>
  {% for row in cra_rows %}
  <tr>
    <td><strong>{{ row.ref.req_id }}</strong></td>
    <td>{{ row.ref.title }}</td>
    <td>{{ row.count }}</td>
    <td>{{ row.finding_ids[:3] | join(", ") }}{% if row.count > 3 %} (+{{ row.count - 3 }} more){% endif %}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{% if suppressed %}
<h2>Suppressed findings (showing {{ suppressed | length }} of {{ suppressed_total }}) — marked, never deleted</h2>
<table>
  <tr><th>ID</th><th>Component</th><th>Suppression reason</th></tr>
  {% for f in suppressed %}
  <tr><td><code>{{ f.finding_id }}</code></td><td>{{ f.component or "—" }}</td><td>{{ f.suppression_reason }}</td></tr>
  {% endfor %}
</table>
{% if suppressed_total > suppressed_cap %}
<p style="color:#5a6b62;">…and {{ suppressed_total - suppressed_cap }} more suppressed findings — the complete set (with reasons) is in <code>evidence-pack/findings.json</code>.</p>
{% endif %}
{% endif %}

<h2>Components ({{ components | length }})</h2>
{% if components %}
<table>
  <tr><th>Name</th><th>Version</th><th>Type</th><th>Provenance</th><th>Confidence</th></tr>
  {% for c in components %}
  <tr><td>{{ c.name }}</td><td>{{ c.version or "?" }}</td><td>{{ c.type }}</td><td>{{ c.provenance }}</td><td>{{ "%.2f" | format(c.confidence) }}</td></tr>
  {% endfor %}
</table>
{% else %}
<p>No components recorded by the current pipeline stages.</p>
{% endif %}

<h2>Stage provenance</h2>
<table>
  <tr><th>Stage</th><th>Status</th><th>Duration</th><th>Notes</th></tr>
  {% for s in manifest.stages %}
  <tr><td>{{ s.name }}</td><td>{{ s.status }}</td><td>{{ s.duration_ms }} ms</td><td>{{ s.notes | join("; ") }}</td></tr>
  {% endfor %}
</table>

<footer>{{ liability }}</footer>
</body>
</html>
